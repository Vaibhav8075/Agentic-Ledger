{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "paytm_vyapar_saathi_tools",
  "version": "1.0.0",
  "description": "Phinite Dev Studio Tool Definitions for Paytm Vyapar Saathi Multi-Agent System",
  "tools": [
    {
      "name": "verify_soundbox_packet_receipt",
      "description": "Validates the receipt of a payment transaction against the NPCI switch and the corresponding MQTT Soundbox payload dispatch, ensuring QoS 1 deduplication.",
      "parameters": {
        "type": "object",
        "properties": {
          "txn_id": {
            "type": "string",
            "description": "The unique Paytm transaction ID or NPCI RRN (Retrieval Reference Number)."
          },
          "device_imei": {
            "type": "string",
            "description": "The 15-digit IMEI of the target Soundbox IoT device."
          },
          "timestamp_window": {
            "type": "integer",
            "description": "How far back, in milliseconds, a genuine payment may have cleared. Older receipts are treated as replays."
          },
          "claimed_amount": {
            "type": "number",
            "description": "Optional. The amount shown on the customer's payment screen; a mismatch with the gateway record is flagged as a spoof."
          }
        },
        "required": [
          "txn_id",
          "device_imei",
          "timestamp_window"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "VERIFIED_DELIVERED",
              "AUDIO_DELAYED",
              "SPOOF_DETECTED",
              "PENDING_SWITCH"
            ]
          },
          "gateway_hash_matched": {
            "type": "boolean"
          },
          "mqtt_publish_detected": {
            "type": "boolean"
          },
          "puback_received": {
            "type": "boolean"
          },
          "latency_ms": {
            "type": "integer"
          },
          "deduplicated": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "p4b_action_triggered": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "gateway_hash_matched",
          "latency_ms"
        ]
      }
    },
    {
      "name": "parse_supplier_bill_payload",
      "description": "Extracts supplier payment obligations, due dates, and exact fiat amounts from incoming distributor invoices.",
      "parameters": {
        "type": "object",
        "properties": {
          "raw_message": {
            "type": "string",
            "description": "The raw text of the invoice received via SMS or WhatsApp, containing line items and totals."
          },
          "vendor_id": {
            "type": "string",
            "description": "The recognized GSTIN or VPA (Virtual Payment Address) of the distributor."
          }
        },
        "required": [
          "raw_message",
          "vendor_id"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "vendor_id": {
            "type": "string"
          },
          "vendor_name": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "due_amount": {
            "type": "number"
          },
          "cutoff_time": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "amount": {
                  "type": "number"
                }
              }
            }
          },
          "pii_redacted": {
            "type": "boolean"
          }
        },
        "required": [
          "vendor_id",
          "due_amount",
          "cutoff_time",
          "pii_redacted"
        ]
      }
    },
    {
      "name": "simulate_cashflow_trajectory",
      "description": "Plans an EMI-safe payment of a supplier bill from the merchant's ledger: pay from the unsettled balance above the EMI reserve, offer a capped advance for a gap covered by the conservative forecast floor of tonight's sales, otherwise pay what is safe and leave the rest unpaid.",
      "parameters": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string",
            "description": "Paytm Merchant ID (MID). The balance and EMI are read from its ledger."
          },
          "due_amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Bill amount to pay the supplier."
          },
          "cutoff_time": {
            "type": "string",
            "description": "Optional ISO 8601 time by which the supplier must be paid."
          },
          "vendor_id": {
            "type": "string",
            "description": "Supplier VPA or GSTIN, used in the notification and deep link."
          }
        },
        "required": [
          "merchant_id",
          "due_amount"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string"
          },
          "current_unsettled_balance": {
            "type": "number"
          },
          "requested_settlement": {
            "type": "number"
          },
          "daily_loan_emi": {
            "type": "number"
          },
          "advance_limit": {
            "type": "number"
          },
          "assertion_passed": {
            "type": "boolean",
            "description": "Strict check without any forecast: due + EMI <= balance."
          },
          "decision": {
            "type": "string",
            "enum": [
              "PAY_FROM_BALANCE",
              "PAY_WITH_ADVANCE",
              "PARTIAL_PAYMENT"
            ]
          },
          "safe_settlement_limit": {
            "type": "number"
          },
          "recommended_micro_settlement": {
            "type": "number"
          },
          "advance_amount": {
            "type": "number"
          },
          "unpaid_amount": {
            "type": "number"
          },
          "evening_forecast_expected": {
            "type": "number"
          },
          "evening_forecast_floor": {
            "type": "number"
          },
          "projected_eod_balance": {
            "type": "number"
          },
          "instant_fee": {
            "type": "number"
          },
          "action_deep_link": {
            "type": "string"
          },
          "p4b_notification_payload": {
            "type": "object"
          }
        },
        "required": [
          "decision",
          "recommended_micro_settlement",
          "advance_amount",
          "unpaid_amount",
          "projected_eod_balance",
          "action_deep_link"
        ]
      }
    },
    {
      "name": "execute_targeted_micro_settlement",
      "description": "Triggers a real-time instant payout to the merchant's mapped bank account for a precise, optimized amount.",
      "parameters": {
        "type": "object",
        "properties": {
          "merchant_id": {
            "type": "string",
            "description": "The unique 20-character Paytm Merchant ID (MID)."
          },
          "required_amount": {
            "type": "number",
            "description": "The exact fiat amount to be settled to the merchant's linked account, leaving the residual balance intact.",
            "exclusiveMinimum": 0
          },
          "routing_rail": {
            "type": "string",
            "enum": [
              "IMPS",
              "UPI",
              "NEFT"
            ],
            "description": "The underlying banking rail to be used for the instant payout."
          },
          "order_id": {
            "type": "string",
            "description": "Caller-generated order ID, reused unchanged on every retry (idempotency)."
          }
        },
        "required": [
          "merchant_id",
          "required_amount",
          "routing_rail",
          "order_id"
        ],
        "additionalProperties": false
      },
      "response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "TXN_SUCCESS",
              "TXN_PENDING_RECONCILIATION",
              "TXN_FAILED"
            ]
          },
          "transaction_id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "utr_no": {
            "type": "string"
          },
          "settled_date": {
            "type": "string"
          },
          "hmac_signature_verified": {
            "type": "boolean"
          },
          "remaining_ledger_balance": {
            "type": "number"
          },
          "routing_rail": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "transaction_id",
          "amount",
          "hmac_signature_verified"
        ]
      }
    }
  ]
}
